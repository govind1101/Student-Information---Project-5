      <aliases enabled='yes' />
      <column caption='Department Share' datatype='real' default-format='p0.0%' name='[Calculation_0989057233735682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([student_id]) / TOTAL(COUNT([student_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GPA Category' datatype='string' name='[Calculation_0989057248243715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gpa] &lt; 2.50 THEN &quot;Below 2.50&quot;&#13;&#10;ELSEIF [gpa] &lt; 3.00 THEN &quot;2.50-3.00&quot;&#13;&#10;ELSEIF [gpa] &lt; 3.50 THEN &quot;3.00-3.49&quot;&#13;&#10;ELSE &quot;3.50+&quot;&#13;&#10;END' />
      </column>
      <column caption='High GPA Student ' datatype='integer' default-format='p0.0%' name='[Calculation_0989057272823813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gpa] &gt;= 3.50 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Age Group ' datatype='string' name='[Calculation_0989057308205062]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;= 20 THEN &quot;18-20&quot;&#13;&#10;ELSEIF [age] &lt;= 23 THEN &quot;21-23&quot;&#13;&#10;ELSE &quot;24-25&quot;&#13;&#10;END' />
      </column>
      <column caption='Overall GPA Average' datatype='real' name='[Calculation_0989057316814855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([gpa]) }' />
      </column>
      <column caption='GPA Range ' datatype='real' default-format='N' name='[Calculation_0989057346097163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([gpa]) - MIN([gpa])' />
      </column>
